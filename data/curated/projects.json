 "proposals": [
  {
   "id": "tram-linke-2026",
   "name": "Straßenbahnnetz der Studie für die Linksfraktion (August 2026)",
   "source": "proposal",
   "note": "Die Studie schlägt vier Korridore mit zusammen 43,7 km und 91 Haltestellen vor, für die sie höchstens 1,5 Mrd. € ansetzt. Die Haltestellen sind den Karten der Studie entnommen und an den gleichnamigen Bushaltestellen verortet, während der Verlauf dazwischen dem Straßennetz folgt und deshalb von der Studie abweichen kann. Im Korridor A nennt die Studie 22 Haltestellen, von denen ihre Karte nur 21 beschriftet. Die Studie behält die U5 bis Borgweg bei und führt sie als „U5neo“ über bestehende Gleise der U3 und U2 weiter, was hier nicht abgebildet ist.",
   "sources": [
    "Dieter Doege, Jens Ode: „Alternativen für eine Fortsetzung der U5 ab Borgweg“, Studie im Auftrag der Fraktion Die Linke in der Hamburgischen Bürgerschaft, Stand Juli 2026, vorgestellt am 12.08.2026",
    "Haltestellenlagen: gleichnamige Bushaltestellen in OpenStreetMap"
   ],
