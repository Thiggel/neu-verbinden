# API server
DATABASE_URL=postgres://localhost/hamburg_transit
# Ohne diesen Wert erzeugt der Server bei jedem Start ein flüchtiges Geheimnis
# — jede Anmeldung gilt dann nur bis zum nächsten Neustart.
HH_JWT_SECRET=bitte-ersetzen-durch-ein-langes-zufaelliges-geheimnis
HH_DATA_DIR=./data/dist
HH_DATA_VERSION=2026-09
HH_ALLOWED_ORIGIN=http://localhost:3000
PORT=8080

# Web app
NEXT_PUBLIC_API_URL=http://localhost:8080

# --- Betrieb ---------------------------------------------------------------
# Schaltet die Startprüfung scharf: ohne festes Geheimnis, ohne eigene Adresse
# oder mit HH_ALLOWED_ORIGIN=* startet der Server dann gar nicht erst, statt mit
# einer Warnung im Protokoll monatelang falsch zu laufen.
# HH_ENV=production

# Die Adresse der Oberfläche. Im Betrieb Pflicht, mit https.
# HH_ALLOWED_ORIGIN=https://netz.example

# Nur setzen, wenn wirklich ein Proxy davorsteht. Ohne dies teilen sich hinter
# einem Proxy alle Aufrufer ein Limit; mit dies und ohne Proxy kann jeder sein
# eigenes Limit durch eine erfundene Kopfzeile zurücksetzen.
# HH_TRUST_PROXY=1

# Bei einer Datenbank, die im Leerlauf einschläft und nach Rechenzeit abrechnet:
# höher setzen, damit der Hintergrundarbeiter sie nicht wach hält.
# HH_WORKER_IDLE_SECS=600
# HH_DB_IDLE_SECS=120

# Rückmeldungen aus dem Feedback-Fenster gehen an diese Adresse, versandt über
# das genannte Programm (es bekommt die Nachricht auf der Standardeingabe und
# wird mit -t aufgerufen: sendmail, msmtp, ssmtp). Ohne beides werden sie nur in
# der Tabelle `feedback` gespeichert und nichts geht verloren.
# HH_SENDMAIL=/usr/sbin/sendmail
# HH_FEEDBACK_TO=deine@adresse
